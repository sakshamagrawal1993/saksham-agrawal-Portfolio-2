{
  // App / Vite typecheck project. Deno Edge + one-off scripts stay in `exclude`
  // (see docs/TSCONFIG-WORKSPACE-CLEANUP.md for scope + rollback).
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "supabase",
    "node_modules",
    "tests/libertymd",
    "scripts/libertymd-clinical-evaluation.ts",
    "scripts/libertymd-live-validation.ts",
    "scripts/libertymd-flow-simulation.ts",
    "scripts/publish_phase4_post.ts"
  ]
}